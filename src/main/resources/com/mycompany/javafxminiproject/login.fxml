<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<AnchorPane prefHeight="420.0" prefWidth="620.0"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.javafxminiproject.LoginController">
    <stylesheets>
        <URL value="@/styles/login.css"/>
    </stylesheets>
    <children>

        <!-- Root HBox: panel kiri + panel kanan -->
        <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              styleClass="rootContainer">

            <!-- ===== PANEL KIRI (dekoratif) ===== -->
            <VBox prefWidth="200" alignment="CENTER" spacing="16"
                  styleClass="leftPanel">
                <padding><Insets top="40" bottom="40" left="24" right="24"/></padding>

                <!-- Logo -->
                <StackPane>
                    <Rectangle width="56" height="56" arcWidth="14" arcHeight="14"
                               styleClass="logoBox"/>
                    <Label text="⚡" styleClass="logoIcon"/>
                </StackPane>

                <!-- App name -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="MyApp" styleClass="appName"/>
                    <Label text="Selamat datang kembali" styleClass="appSubtitle"/>
                </VBox>

                <!-- Feature list -->
                <VBox spacing="10" style="-fx-padding: 24 0 0 0;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Circle radius="4" styleClass="dotBlue"/>
                        <Label text="Akses aman" styleClass="featureText"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Circle radius="4" styleClass="dotGreen"/>
                        <Label text="Data terenkripsi" styleClass="featureText"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Circle radius="4" styleClass="dotPurple"/>
                        <Label text="Multi platform" styleClass="featureText"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ===== PANEL KANAN (form) ===== -->
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="20"
                  styleClass="rightPanel">
                <padding><Insets top="40" bottom="40" left="40" right="40"/></padding>

                <!-- Judul -->
                <VBox spacing="4" style="-fx-padding: 0 0 8 0;">
                    <Label text="Login" styleClass="formTitle"/>
                    <Label text="Masuk ke akun Anda" styleClass="formSubtitle"/>
                </VBox>

                <!-- Field Username -->
                <VBox spacing="6" maxWidth="Infinity" VBox.vgrow="NEVER">
                    <Label text="Username" styleClass="fieldLabel"/>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="inputBox">
                        <Label text="👤" styleClass="inputIcon"/>
                        <TextField fx:id="usernameField"
                                   promptText="Masukkan username..."
                                   HBox.hgrow="ALWAYS"
                                   styleClass="inputField"/>
                    </HBox>
                </VBox>

                <!-- Field Password -->
                <VBox spacing="6" maxWidth="Infinity" VBox.vgrow="NEVER">
                    <Label text="Password" styleClass="fieldLabel"/>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="inputBox">
                        <Label text="🔒" styleClass="inputIcon"/>
                        <PasswordField fx:id="passwordField"
                                       promptText="Masukkan password..."
                                       HBox.hgrow="ALWAYS"
                                       styleClass="inputField"/>
                    </HBox>
                </VBox>

                <!-- Remember me + lupa password -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <CheckBox fx:id="rememberMe" text="Ingat saya"
                              styleClass="rememberCheck"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Lupa password?" styleClass="forgotLink"
                           onMouseClicked="#handleForgotPassword"/>
                </HBox>

                <!-- Tombol Login -->
                <Button text="Login" onAction="#handleLogin"
                        maxWidth="Infinity" styleClass="loginButton"/>

                <!-- Daftar -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="Belum punya akun?" styleClass="registerText"/>
                    <Label text="Daftar sekarang" styleClass="registerLink"
                           onMouseClicked="#handleRegister"/>
                </HBox>

            </VBox>
        </HBox>
    </children>
</AnchorPane>